alias lever d0
alias cargoUmbilical d1
alias LED d2

define rocketCargoSmall -1493672123
define rocketCargoMedium 1151864003

idle:
s LED On 1
s LED Color 2
s cargoUmbilical Open 0
sb rocketCargoSmall Open 0
sb rocketCargoMedium Open 0
sb rocketCargoMedium On 0
sb rocketCargoMedium On 0
l r0 lever On
beq r0 1 unloadCargo
yield
j idle

unloadCargo:
s cargoUmbilical Open 1
sb rocketCargoSmall On 1
sb rocketCargoMedium On 1
sb rocketCargoSmall Open 1
sb rocketCargoMedium Open 1
unloadingLoop:
s LED On 1
s LED Color 4
l r0 lever On
beq r0 0 cargoUnloadingDone
lb r0 rocketCargoSmall Quantity Sum
lb r1 rocketCargoMedium Quantity Sum
add r0 r0 r1
beq r0 0 cargoUnloadingDone
yield
j unloadingLoop

cargoUnloadingDone:
sb rocketCargoSmall Open 0
sb rocketCargoMedium Open 0
sb rocketCargoMedium On 0
sb rocketCargoSmall On 0
yield
s lever On 0
j idle