
alias pressureReading d0
alias fuelPump d1
alias lever d2
alias LED d3
alias safetyValve d4

define gasUmbilical -1814939203

define maxPressurePa 45000

idle:
s pressureReading On 1
s safetyValve Setting 45050
s safetyValve On 1
s fuelPump On 0
sb gasUmbilical Open 0
s LED On 1
s LED Color 2
l r0 lever Setting
beq r0 1 lowPressure
j idle

lowPressure:
s pressureReading On 1
s safetyValve Setting 59000
s safetyValve On 1
s LED On 1
s LED Color 4
l r0 pressureReading Pressure
s db Setting r0
bgeal r0 maxPressurePa safetyCheck
l r0 lever Setting
beq r0 0 safetyCheck
sb gasUmbilical Open 1
s fuelPump On 1
yield
j lowPressure

#allow regulators to depressurize over 45mpa
safetyCheck:
s lever On 0
s safetyValve Setting 45000
s safetyValve On 1
s fuelPump On 0
s LED On 1
s LED Color 3
l r0 pressureReading Pressure
s db Setting r0
add r1 maxPressurePa 50
bleal r0 r1 idle
yield
j safetyCheck