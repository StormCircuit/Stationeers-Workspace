
alias pressureReading d0
alias fuelPump d1
alias lever d2
alias LED d3

define maxPressurePa 45000

idle:
s pressureReading On 0
s fuelPump On 0
s LED On 1
s LED Color 2
l r0 lever Setting
beq r0 1 lowPressure
j idle

lowPressure:
s LED On 1
s LED Color 4
l r0 pressureReading Pressure
s db Setting r0
bgeal r0 maxPressurePa safetyCheck
s pressureReading On 1
s fuelPump On 1
yield
j lowPressure

#allow regulators to depressurize over 45mpa
safetyCheck:
s LED On 1
s LED Color 3
l r0 pressureReading Pressure
s db Setting r0
bleal r0 maxPressurePa idle
j safetyCheck