clr db
move sp 0
alias dirciRoutine d0
#configure dirci below:
put dirciRoutine 510 20000 #use 20,000 watts for charge error
put dirciRoutine 509 45 #use 45 ticks until force from load to move out
#Route format:
#Length of the route in number of waypoints
#Each waypoint represented by X and Y coordinates
#Push X1
#Push Z1
#Push X2
#Push Z2 etc
#Route 1, used for space ice (starts at 1, length 14)
push 14
push -278
push -1207
push -275
push -1208
push -274
push -1237
push -256
push -1236
push -232
push -1044
push -215
push -1030
push -214
push -1016
#route 2 is optional, requires vending2
#Route 2, used for space ore (starts at 16, length 20)
push 20
push -274
push -1206
push -275
push -1208
push -274 #end of ramp
push -1237
push -256
push -1236 #edge of crater
push -265
push -1158
push -285
push -1049
push -421
push -1046
push -462
push -1066
push -464
push -1046
push -441
push -1047
