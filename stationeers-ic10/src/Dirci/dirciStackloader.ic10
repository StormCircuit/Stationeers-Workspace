define LastWaypoint 6 #the mining site waypoint (must be last waypoint)
define ChargeError 20000 #the watts level below which dirci flags a charge error
define x1 -277
define z1 -1207
define x2 -275
define z2 -1209
define x3 -274
define z3 -1237
define x4 -256
define z4 -1236
define x5 -232
define z5 -1044
define x6 -214
define z6 -1016
define x7 0
define z7 0
define x8 0
define z8 0
clr db
alias lstwp r6 #holding register for last waypoint
mul lstwp LastWaypoint 2 #mul lastwaypoint by 2 as it's compared to sp
put db 0 x1
put db 1 z1
put db 2 x2
put db 3 z2
put db 4 x3
put db 5 z3
put db 6 x4
put db 7 z4
put db 8 x5
put db 9 z5
put db 10 x6
put db 11 z6
put db 12 x7
put db 13 z7
put db 14 x8
put db 15 z8
put db 511 lstwp #last waypoint * 2
put db 510 ChargeError