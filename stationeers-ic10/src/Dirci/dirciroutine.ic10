alias robotXmitter d0    #By Cows Are Evil, modified EXTENSIVELY by StormCircuit
alias recallLever d1     #Anything with a Setting. Setting = 1 = recall/reset error
alias secondaryRecall d2 #Optional secondary recall signal. OR's with above
s robotXmitter Mode 0    #r15=ra,r14=workError,r13=stuck,r12=topOfStack,
arrivedHome:             #r0 thru r5 are temp registers
move sp 0
get r12 db 511 #load new max waypoints
jal batteryWeatherCheckRecall
brnez r0 -1 #loop while recall/error
move r2 0
loadingLoop:
s robotXmitter Mode 2
yield
add r2 r2 1
l r0 robotXmitter Mode
beq r2 45 goingToWork #if stuck, go to work anyway (takes abt 45 secs to fill)
beq r0 2 loadingLoop #wait till dirci NOT loading
j goingToWork
goingHomeStart:
add sp sp 1 #accessible if working/goingToWork
goingHomeLoop:
jal batteryWeatherCheckRecall #==BEGIN GOING arrivedHome LOOP==# update stack
ble sp 1 arrivedHome
sub sp sp 1
peek r3
sub sp sp 1
peek r2
sub r2 r2 1 #basic collision avoidance
sub r3 r3 1
s robotXmitter TargetX r2
s robotXmitter TargetZ r3
jal travel
j goingHomeLoop
goingToWork:
jal batteryWeatherCheckRecall
bne r0 0 goingHomeStart
add sp sp 1
peek r2
add sp sp 1
peek r3
blt sp r12 noOffset #if last waypoint in stack, randomize coords by given memory
jal getOffset
add r2 r2 r0 #load WAYX
jal getOffset
add r3 r3 r0 #load WAYZ
noOffset:
s robotXmitter TargetX r2
s robotXmitter TargetZ r3
jal travel
bge sp r12 workSite
j goingToWork
getOffset:
get r1 db 509 # last wp range is stored at stack address 509 / is our max range
rand r0
mul r0 r1 r0 #store offset in r0 then randomly flip sign
rand r1 #randomly flip sign
brgt r1 0.5 2
mul r0 r0 -1
j ra #go back to goingToWork
workSite:
s robotXmitter Mode 3
yield
move r1 2 #skip past battery and ic10 slots
move r2 0
occupiedSlotsCalc:
l r0 robotXmitter Mode
beq r0 5 goingHomeStart #if robot is empty, go home
ls r0 robotXmitter r1 Occupied
add r2 r2 r0
add r1 r1 1
breq r1 11 2 #if reached the last slot, exit loop
j occupiedSlotsCalc
beqz r2 goingHomeStart #if no occupied slots, go home (attempt to speed Dirci up)
j workSite #else recalculate until 0 or empty
travel:
move r15 ra #store ra
travelLoop:
s robotXmitter Mode 1
l r0 robotXmitter PositionY
s robotXmitter TargetY r0
jal batteryWeatherCheckRecall
breqz r0 5
brlt r15 goingToWork 4 # if from gohome, skip next
move r15 goingHomeStart
sub sp sp 2 #get last waypoint
s robotXmitter Mode 0 #set robot to idle to trigger instant reverse
yield
l r0 robotXmitter Mode
bne r0 0 travelLoop 
j r15 #use stored ra, if error/recall is on then this is goingHome
batteryWeatherCheckRecall:
l r0 recallLever Setting
brdns secondaryRecall 3 #if no secondary recall, skip secondary check
l r1 secondaryRecall Setting
or r3 r0 r1 #combine recall signals, store in r3
breqz r0 2 #if recall signal set, workerror must clear
move r14 0
ls r0 robotXmitter 0 Charge #check if below SP 505
get r1 db 510 #check charge value against SP 510 in watts
slt r2 r0 r1
or r2 r2 r14 #if Charge OR work error then r2 = 1
s db Setting r2 #this means you can clear a battery error by just fixing it
lb r0 1997212478 NextWeatherEventTime Sum
sne r0 r0 0
or r0 r0 r3 #OR weather/recall
or r0 r2 r0 #OR charge/Work Error/recall signal/weather into r0
j ra