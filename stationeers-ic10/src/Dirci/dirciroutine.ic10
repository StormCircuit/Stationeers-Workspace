alias robotXmitter d0  #=Based on Cows Are Evil, modified EXTENSIVELY by StormCircuit=
alias recallLever d1   #Anything with a Setting. 1 = recall/reset error
alias secondaryRecall d2 #secondary source of recall signal. does an OR check on above
s robotXmitter Mode 0  
#r2=stuck,r3=topOfStack,r4=WAYX,r5=WAYZ,r6=internal recall signal, r15=ra

homePoint:                
move sp 0 #realign sp
get r3 db 511 #load new max waypoints at homePoint position
jal batteryWeatherCheckRecall
yield
brnez r6 -2 #skip back to homePoint loop
s robotXmitter Mode 2
yield
l r0 robotXmitter Mode
yield
breq r0 2 -2 #wait till dirci NOT loading

goingToWork:
jal batteryWeatherCheckRecall
bne r6 0 goingHomeStart
add sp sp 1
peek r4
add sp sp 1
peek r5
add r4 r4 r0 #load WAYX
add r5 r5 r0 #load WAYZ
s robotXmitter TargetX r4
s robotXmitter TargetZ r5
jal travel
bge sp r3 unloadPoint
j goingToWork

unloadPoint:
s robotXmitter Mode 3
yield
l r0 robotXmitter Mode
yield
brne r0 5 -2 #wait till empty
j goingHomeStart

goingHomeStart:
add sp sp 1 #accessible if mining/goingToWork
goingHomeLoop:
jal batteryWeatherCheckRecall #==BEGIN GOING homePoint LOOP==# update stack
ble sp 1 homePoint
sub sp sp 1
peek r5
sub sp sp 1
peek r4
sub r4 r4 1 #collision avoidance
sub r5 r5 1
s robotXmitter TargetX r4
s robotXmitter TargetZ r5
jal travel
j goingHomeLoop #==END GOING homePoint LOOP==

travel:
move r15 ra #store ra
travelLoop: #==BEGIN TRAVEL WAIT LOOP ON THIS LINE==
s robotXmitter Mode 1  
l r0 robotXmitter PositionY
s robotXmitter TargetY r0
jal batteryWeatherCheckRecall
breqz r6 5
brge r15 goingToWork 4 # if from gohome, skip next
move r15 goingHomeStart
sub sp sp 2 #store gohome in r1, get last waypoint
s robotXmitter Mode 0 #set robot to idle to trigger instant reverse
yield
l r0 robotXmitter Mode
bne r0 0 travelLoop #==END TRAVEL WAIT LOOP ON THIS LINE==
j r15 #use stored ra, if error/recall is on then this is goingHome

batteryWeatherCheckRecall:
put db 507 sp #sp, all these are read only
put db 506 ra #ra
put db 502 r5 #WAYZ
put db 501 r4 #WAYX
ls r0 robotXmitter 0 Charge #check if below SP 505
get r1 db 505 #check charge value against SP 505 in watts
slt r6 r0 r1
brnez r6 13 #if charge check = 1 then skip rest, SET error SIGNAL/Setting
or r6 r6 r7 #if any above OR mining error, recall
l r0 recallLever Setting
sgt r0 r0 0 #normalize the recall signal
brdns secondaryRecall 4 #if no secondary recall, skip secondary check
l r1 secondaryRecall Setting
sgt r1 r1 0 #normalize the secondary recall signal
or r0 r0 r1 #combine recall signals
or r6 r6 r0 #if recall signal OR charge error OR mining error then r6 = 1
breqz r0 4 #if recall signal set, MiningError must clear
s db Setting 0
move r7 0
jr 2
s db Setting r6 #this means you can clear a battery error by just fixing it
lb r0 1997212478 NextWeatherEventTime Sum
or r6 r6 r0 #If damage/charge/Mining Error/recall signal/weather then r6 = 1
j ra