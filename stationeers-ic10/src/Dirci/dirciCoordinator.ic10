alias robotXmitter d0
alias recallSwitch d4
alias dirciRoutine d1
alias vending1 d2
alias vending2 d3

alias targetStatus r11 #route we want to switch to
alias currStatus r12 #current vending we're operating on
alias vendOccuSlots r13 #holding var for occupied slots in vending machine
alias roboOccuSlots r14 #holding var for occupied slots in Dirci

define Route1Start 0
define Route1End 12
define Route2Start 12
define Route2End 32

#check both machines, if already on proper route then do nothing
#after checking, if they need unloading, we should check Dirci
put dirciRoutine 508 0 #initialize dirci reroute flag to 0
move currStatus 1
l r0 recallSwitch Setting
brnez r0 -1 #spin while recall switch is active
monitorLoop:
yield
#begin with checking if dirci is empty
move r0 2 #skip past battery and ic10 slots
move roboOccuSlots 0
roboSlotsCalc:
ls r2 robotXmitter r0 Occupied
add roboOccuSlots roboOccuSlots r2
add r0 r0 1
breq r0 12 2
j roboSlotsCalc
bnez roboOccuSlots monitorLoop #if not empty, loop

#dirci is empty and so can be rerouted

#find which vending machine needs unloading
move vendOccuSlots 0
move r0 2 #index iterable
move r1 0 #holding var for occupied slots in vending machine
vend1SlotsCalc: #space ice vending machine
ls r2 vending1 r0 Occupied
add r1 r1 r2
add r0 r0 1
breq r0 102 2
j vend1SlotsCalc
breqz r1 2 #if NO occupied slots, skip next
move targetStatus 1 #targetStatus = 1 (st vending machine)
add vendOccuSlots r0 vendOccuSlots

move r0 2 #index iterable
move r1 0 #holding var for occupied slots in vending machine
vend2SlotsCalc: #space ore vending machine
ls r2 vending2 r0 Occupied
add r1 r1 r2
add r0 r0 1
breq r0 102 2
j vend2SlotsCalc
breqz r1 2 #if NO occupied slots, skip next
move targetStatus 2 #targetStatus = 2 (nd vending machine)
add vendOccuSlots r0 vendOccuSlots

#begin check if dirci is available for reroute
get r1 dirciRoutine 508
bnez r1 monitorLoop #then dirci is not ready to have her route swapped, loop
beq currStatus targetStatus monitorLoop #status unchanged, loop

put dirciRoutine 508 1 #flag dirciRoutine for rerouting

#commit to changing her route now
s db Setting 1 #issue a recall so we can have a stable handoff state and wait
get r0 dirciRoutine 508
brne r0 2 -1 #wait for dirci to signal she's ready for loading

#begin route loading
move r0 Route1Start
move r1 Route1End
beq targetStatus 1 routeLoad
move r0 Route2Start
move r1 Route2End
beq targetStatus 2 routeLoad
#placeholder for more routes
routeLoad:
move sp r0
routeLoop:
bgt r0 r1 endVendCheck
peek r2
put dirciRoutine r0 r2
add r0 r0 1
add sp sp 1
j routeLoop
endVendCheck:
put dirciRoutine 511 r1 #load last waypoint into dirci's settings
move currStatus targetStatus #update status
put dirciRoutine 508 3 #signal routine that load is complete
get r0 dirciRoutine 508
brne r0 4 -1 #wait for dirciRoutine to finish repositioning
put dirciRoutine 508 0 #clear reroute flag
s db Setting 0 #release dirci lock
j monitorLoop