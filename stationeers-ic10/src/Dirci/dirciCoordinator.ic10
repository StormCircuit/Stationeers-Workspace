alias vending1 d0
alias robotXmitter d1
alias dirciRoutine d2

alias targetStatus r12
alias currStatus r13 #current machine we're operating on
alias vendOccuSlots r14
alias roboOccuSlots r15

#check both machines, if already on proper route then do nothing
#after checking, if they need unloading, we should check Dirci

monitorLoop:

move r0 2
move vendOccuSlots 0
vend1SlotsCalc:
ls r2 vending1 r0 Occupied
add vendOccuSlots vendOccuSlots r2
add r0 r0 1
breq r0 102 2
j vend1SlotsCalc
brnez r0 2 #if NO occupied slots, skip next
move targetStatus 1 #targetStatus = 1 (st vending machine)

move r0 2
move vendOccuSlots 0
vend2SlotsCalc:
ls r2 vending2 r0 Occupied
add vendOccuSlots vendOccuSlots r2
add r0 r0 1
breq r0 102 2
j vend2SlotsCalc
brnez r0 2 #if NO occupied slots, skip next
move targetStatus 2 #targetStatus = 2 (nd vending machine)

get r0 dirciRoutine ra #if dirci is in idle at unload
sle r0 r0 8
move r0 2 #skip past battery and ic10 slots
move roboOccuSlots 0
roboSlotsCalc:
ls r2 robotXmitter r0 Occupied
add roboOccuSlots roboOccuSlots r2
add r0 r0 1
breq r0 12 2
j roboSlotsCalc
seqz r1 roboOccuSlots #if dirci is empty
l r2 robotXmitter Mode
seqz r3 r2 #if dirci is idle
and r0 r0 r1
and r0 r0 roboOccuSlots
and r0 r0 r3
beqz r0 monitorLoop #then dirci is not ready to have her route swapped

#commit to changing her route now
s db Setting 1 #issue a recall so we can have a stable handoff state and wait
l r0 robotXmitter Mode
brnez r0 -1

define Route1Start 1
define Route1End 12
define Route2Start 13
define Route2End 24

loadDirciRoute:
move r0 Route1Start
move r1 Route1End
seq r2 targetStatus 2
beqz r2 routeLoad
move r0 Route2Start
move r1 Route2End

routeLoad:
move sp r0
routeLoop:
bgt r0 r1 endVendCheck
peek r2
put dirciRoutine r0 r2
add r0 r0 1
add sp sp 1
j routeLoop

endVendCheck:
s db Setting 0 #release lock
yield
j monitorLoop

