alias vending d0
alias robotXmitter d1

alias index r12
alias currStatus r13
alias vendOccuSlots r14
alias roboOccuSlots r15

monitorLoop:
move currStatus 0

move index 2
move vendOccuSlots 0
vendSlotsCalc:
ls r2 vending index Occupied
add vendOccuSlots vendOccuSlots r2
add index index 1
breq index 102 2
j vendSlotsCalc

move index 2 #skip past battery and ic10 slots
move roboOccuSlots 0
roboSlotsCalc:
ls r2 robotXmitter index Occupied
add roboOccuSlots roboOccuSlots r2
add index index 1
breq index 12 2
j roboSlotsCalc


#if no slots occupied AND Dirci is empty then recall Dirci
yield 
seqz r0 vendOccuSlots
seqz r1 roboOccuSlots
and currStatus r1 r0
s db Setting currStatus

yield
j monitorLoop